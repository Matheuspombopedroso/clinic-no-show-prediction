# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Directory with model.json + metadata.json produced by `python -m noshow.train`.
MODEL_DIR=artifacts/no-show-xgb/1.0.0

# Horizontal scaling: number of Ray Serve replicas (one model copy per process).
NUM_REPLICAS=1

# Dynamic batching for POST /predict (@serve.batch):
#   MAX_BATCH_SIZE       - max requests merged into one model call
#   BATCH_WAIT_TIMEOUT_S - max seconds the first request waits for the batch to fill
MAX_BATCH_SIZE=32
BATCH_WAIT_TIMEOUT_S=0.005

# Concurrent in-flight requests per replica. Kept >= MAX_BATCH_SIZE (enforced in code).
MAX_ONGOING_REQUESTS=64

# XGBoost threads per replica. 1 = scale with replicas, not threads.
MODEL_THREADS=1

# Where the Ray Serve HTTP proxy listens. Use 0.0.0.0 inside Docker.
SERVE_HOST=127.0.0.1
SERVE_PORT=8000

# Per-request access log lines in the Serve proxy and replicas (true/false).
# Off by default because logging every request costs CPU at high request rates.
ACCESS_LOG=false
